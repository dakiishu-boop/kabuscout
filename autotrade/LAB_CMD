# 2026-11-28 診断: 本番の初回（2026-11-27 引け後）で買いの注文が1件だけだった理由。本番のデータ・モデルを読むだけ（書き込まない・通知しない）
import warnings; warnings.filterwarnings("ignore")
import logging; logging.basicConfig(level=logging.INFO, format="%(asctime)s %(name)s %(message)s", datefmt="%H:%M:%S")
from pathlib import Path
import numpy as np, pandas as pd
from kabuscout.config import load_config
from kabuscout.data import PriceStore
from autotrade import live, data as D
cfg = load_config(Path("config.yaml"))
s = live.load_settings()
p = live.params_of(s)
proxy = cfg["universe"]["market_proxy"]
end = PriceStore(cfg["data"]["price_dir"]).load(fields=["close"], codes=[proxy])["close"][proxy].dropna().index[-1]
start = (end - pd.Timedelta(days=900)).strftime("%Y-%m-%d")
ds, market, masks = D.build(cfg, horizons=(), start=start)
cix = {c: j for j, c in enumerate(market.codes)}
mp = live.state_dir(cfg) / "model.joblib"
print("DIAG model file exists", mp.exists())
b = live.load_model(cfg, s)
print("DIAG model trained", b["trained"], "params n_hold", p.n_hold, "depth", p.depth, "lot", p.lot, "cost", p.cost)
names = live._names(s)
danger = live._danger(cfg)
print("DIAG danger list", len(danger))
half = p.cost / 2
for k in (4, 3, 2, 1, 0):
    i = len(market.cal) - 1 - k
    d = market.cal[i]
    rows = ds[ds["date"] == d]
    sc = dict(zip(rows["code"], live.score(b, rows)))
    elig = set(rows.loc[rows["elig"], "code"]) - set(danger)
    nfin = int(np.isfinite(market.close[i]).sum())
    ranked = sorted((c for c in sc if c in elig), key=lambda c: -sc[c])
    px = np.array([market.close[i, cix[c]] for c in ranked])
    ok200 = px * 100 * (1 + half) <= 200000
    ok100 = px * 100 * (1 + half) <= 100000
    pe = np.array([market.close[i, cix[c]] for c in elig])
    print(f"DIAG {d.date()} rows {len(rows)} elig {len(elig)} finite closes {nfin} | "
          f"top25 buyable with 200k: {int(ok200[:25].sum())} / with 100k: {int(ok100[:25].sum())} | "
          f"all eligible buyable with 200k: {(pe * 100 * (1 + half) <= 200000).mean():.0%} / 100k: {(pe * 100 * (1 + half) <= 100000).mean():.0%}")
    if k in (0, 1):
        for r, c in enumerate(ranked[:30]):
            print(f"DIAG   {r + 1:2d} {c} {names.get(c, '')[:14]:14s} 終値 {px[r]:>9,.1f} 100株 {px[r] * 100:>10,.0f}円 "
                  f"{'200k可' if ok200[r] else '      '} {'100k可' if ok100[r] else ''} 点数 {sc[c]:.4f}")
# 銘柄ごとの値段の分布（対象の全銘柄・最新日）
i = len(market.cal) - 1
rows = ds[ds["date"] == market.cal[i]]
e = rows[rows["elig"]]
pr = pd.Series([market.close[i, cix[c]] for c in e["code"]])
print("DIAG eligible price quantiles", pr.quantile([.1, .25, .5, .75, .9]).round(0).to_dict())
EOF
